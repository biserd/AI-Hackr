{
  "name": "@aihackr/web-data",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node dist/src/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test scripts",
    "test:unit": "tsx --test test/unit.test.ts",
    "test:integration": "tsx --test test/integration.test.ts",
    "test:e2e": "tsx --test test/e2e.test.ts",
    "test:mcp": "tsx --test test/mcp.test.ts",
    "test": "tsx --test --test-concurrency=1 test/unit.test.ts test/integration.test.ts test/e2e.test.ts test/mcp.test.ts test/compat.test.ts test/oauth.test.ts",
    "plugin:build": "tsx scripts/plugin.ts build",
    "plugin:validate": "tsx scripts/plugin.ts validate",
    "benchmark": "tsx scripts/benchmark.ts",
    "contracts": "tsx scripts/contracts.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@modelcontextprotocol/sdk": "1.32.2",
    "ajv": "8.20.0",
    "cheerio": "1.0.0",
    "express": "4.22.3",
    "fflate": "0.8.3",
    "ipaddr.js": "2.2.0",
    "jose": "5.10.0",
    "js-tiktoken": "1.0.21",
    "openai": "7.53.0",
    "openid-client": "6.8.9",
    "pg": "8.16.3",
    "robots-parser": "3.0.1",
    "stripe": "23.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@mendable/firecrawl-js": "4.52.0",
    "@types/express": "4.17.21",
    "@types/node": "22.19.0",
    "@types/pg": "8.15.6",
    "eslint": "9.39.1",
    "prettier": "3.9.10",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.3"
  }
}
