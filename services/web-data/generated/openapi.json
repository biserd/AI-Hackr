                  "maxCredits": {
                    "default": 10,
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10000
                  },
                  "quoteId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "idempotencyKey": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "required": [
