{
  "openapi": "3.0.3",
  "info": {
    "title": "AIHackr Web Data",
    "version": "0.1.0",
    "description": "Native async REST contracts. Optional providers are unavailable until configured."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:4100",
      "description": "Local fixture service"
    }
  ],
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "http",
        "scheme": "bearer"
      },
      "oauth": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://auth.aihackr.com/realms/aihackr/protocol/openid-connect/auth",
            "tokenUrl": "https://auth.aihackr.com/realms/aihackr/protocol/openid-connect/token",
            "scopes": {
              "web:read": "Read public web using prepaid credits",
              "jobs:read": "Read own jobs",
              "jobs:write": "Start and cancel jobs",
              "usage:read": "Inspect own balance"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/v1/scrape": {
      "post": {
        "operationId": "scrape",
        "security": [
          {
            "apiKey": []
          },
          {
            "oauth": [
              "web:read",
              "jobs:write"
            ]
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "maxLength": 2048,
                    "format": "uri"
                  },
                  "formats": {
                    "default": [
                      "markdown"
                    ],
                    "minItems": 1,
                    "maxItems": 4,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "markdown",
                        "text",
                        "html",
                        "links"
                      ]
                    }
                  },
                  "render": {
                    "default": "auto",
                    "type": "string",
                    "enum": [
                      "http",
                      "auto",
                      "browser"
                    ]
                  },
                  "maxAgeSeconds": {
                    "default": 3600,
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 86400
                  },
                  "maxCredits": {
                    "default": 5,
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10000
                  },
                  "quoteId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "idempotencyKey": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "required": [
                  "url"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted bounded job; poll status and read retained results."
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "402": {
            "description": "Insufficient funds or credit ceiling"
          },
          "409": {
            "description": "Idempotency conflict"
          },
          "503": {
            "description": "Capability unavailable"
          }
        }
      }
    },
    "/v1/search": {
      "post": {
        "operationId": "search",
        "security": [
          {
            "apiKey": []
          },
          {
            "oauth": [
              "web:read",
              "jobs:write"
            ]
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "limit": {
                    "default": 10,
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 20
                  },
                  "country": {
                    "type": "string",
                    "pattern": "^[A-Z]{2}$"
                  },
                  "language": {
                    "type": "string",
                    "pattern": "^[a-z]{2}$"
                  },
                  "maxCredits": {
                    "default": 4,
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10000
                  },
                  "quoteId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "idempotencyKey": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "required": [
                  "query"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted bounded job; poll status and read retained results."
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "402": {
            "description": "Insufficient funds or credit ceiling"
          },
          "409": {
            "description": "Idempotency conflict"
          },
          "503": {
            "description": "Capability unavailable"
          }
        }
      }
    },
