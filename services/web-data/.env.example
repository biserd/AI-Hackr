# Local fixture mode only; never enable in production.
DEV_FIXTURES=true
PORT=4100
BIND_HOST=127.0.0.1
PUBLIC_API_ORIGIN=http://127.0.0.1:4100
DASHBOARD_ORIGIN=http://localhost:5000
# Production requires PostgreSQL and DEV_FIXTURES=false.
DATABASE_URL=
# Existing Cloudflare container uses this mode instead of a PostgreSQL host:
# WEB_DATA_STORAGE=cloudflare
# WEB_DATA_STORAGE_TOKEN is injected from a Cloudflare Worker secret, never a public client.
LIVE_HTTP_ENABLED=false
HTTP_COST_MICRO_USD=100
MAX_PROVIDER_COST_MICRO_USD=50000
BRAVE_SEARCH_API_KEY=
SEARCH_COST_MICRO_USD=
OPENAI_API_KEY=
EXTRACTION_MODEL=gpt-4.1-mini
# Operator must supply current contracted rates; no guessed provider prices.
MODEL_INPUT_MICRO_USD_PER_MILLION=
MODEL_OUTPUT_MICRO_USD_PER_MILLION=
# Private renderer only. Keep disabled pending sandbox/egress/resource rehearsal.
FIRECRAWL_BROWSER_URL=
BROWSER_SECURITY_REHEARSED=false
# Same high-entropy secret in scanner server and web-data service.
WEB_DATA_CONTROL_TOKEN=
# Set these in the existing scanner service:
# WEB_DATA_API_URL=http://web-data:4100
# WEB_DATA_DASHBOARD_ORIGIN=https://aihackr.com
STRIPE_TEST_KEY=
STRIPE_WEBHOOK_SECRET=
OAUTH_ISSUER=
OAUTH_JWKS_URL=
OAUTH_LINK_CLIENT_ID=aihackr-dashboard-link
OAUTH_LINK_CLIENT_SECRET=
OAUTH_AGENT_CLIENT_ID=aihackr-plugin
WEB_DATA_KILL_SWITCH=false
