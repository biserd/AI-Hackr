{
  "name": "aihackr-firecrawl-edge",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "node native/scripts/build-edge.mjs",
    "deploy": "node native/scripts/deploy-edge.mjs",
    "test": "npm --prefix native test",
    "native:install": "npm --prefix native ci --ignore-scripts",
    "native:prepare": "node native/scripts/verify-source.mjs && node native/scripts/prepare-build.mjs",
    "native:up": "docker compose -f native/compose.yaml --env-file native/.env up --build -d --wait --wait-timeout 360"
  },
  "devDependencies": { "wrangler": "4.158.0" }
}
