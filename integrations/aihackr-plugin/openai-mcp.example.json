{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "aihackr": {
      "type": "streamable-http",
      "url": "https://aihackr.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "resource": "https://aihackr.com/mcp",
            "baseScopes": [
              "account:read",
              "web:read",
              "crawl:read",
              "crawl:write",
              "offline_access"
            ]
          }
        }
      }
    }
  }
}
