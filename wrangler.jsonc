{
  "$schema": "./cloudflare/node_modules/wrangler/config-schema.json",
  "name": "aihackr",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-08",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "triggers": {
    "crons": []
  },
  "account_id": "73d71a2bef58f7469ecb48e2b8e84c0e",
  "routes": [
    {
      "pattern": "aihackr.com",
      "custom_domain": true
    },
    {
      "pattern": "www.aihackr.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  "browser": {
    "binding": "BROWSER"
  },
  "vars": {
    "REVIEWER_LOGIN_EXPIRES_AT": "2027-02-09T00:00:00Z",
    "OAUTH_ISSUER": "https://aihackr.com",
    "CLOUDFLARE_ACCOUNT_ID": "73d71a2bef58f7469ecb48e2b8e84c0e",
    "DAILY_PAGE_LIMIT": "1000",
    "STRIPE_PRICES_V2": "{\"starter\":\"price_1UaPZjRwvWaTf8xfpioORU86\",\"builder\":\"price_1UaPZlRwvWaTf8xfnARIyvf0\",\"scale\":\"price_1UaPZnRwvWaTf8xfHxhuoWfG\"}",
    "STRIPE_PORTAL_CONFIGURATION_V2": "bpc_1UaPZoRwvWaTf8xf4LlZdFXV"
  },
  "alias": {
    "@repo/mcp-common/src/cloudflare-api": "./cloudflare/mcp-client.mjs",
    "@repo/mcp-common/src/request-context": "./cloudflare/mcp-context.mjs"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AIHACKR",
        "class_name": "AIHackrContainer"
      },
      {
        "name": "WEB_DATA_STORE",
        "class_name": "WebDataStore"
      },
      {
        "name": "BROWSER_WORKSPACE",
        "class_name": "BrowserWorkspace"
      },
      {
        "name": "ACCOUNT_DIRECTORY",
        "class_name": "AccountDirectory"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "AIHackrContainer"
      ]
    },
    {
      "tag": "v2-web-data-store",
      "new_sqlite_classes": [
        "WebDataStore"
      ]
    },
    {
      "tag": "v3-browser-run-workspace",
      "new_sqlite_classes": [
        "BrowserWorkspace"
      ]
    },
    {
      "tag": "v4-customer-accounts",
      "new_sqlite_classes": [
        "AccountDirectory"
      ]
    }
  ],
  "env": {
    "staging": {
      "name": "aihackr-browser-run-stage",
      "browser": {
        "binding": "BROWSER"
      },
      "routes": [],
      "vars": {
        "REVIEWER_LOGIN_EXPIRES_AT": "2027-02-09T00:00:00Z",
    "OAUTH_ISSUER": "https://aihackr-browser-run-stage.biser-d.workers.dev",
        "CLOUDFLARE_ACCOUNT_ID": "73d71a2bef58f7469ecb48e2b8e84c0e",
        "DAILY_PAGE_LIMIT": "1000",
        "STRIPE_PRICES_V2": "{\"starter\":\"price_1UaPM92OxvOkZCMOAQNr0OIg\",\"builder\":\"price_1UaPMA2OxvOkZCMOjYCrdXnN\",\"scale\":\"price_1UaPMC2OxvOkZCMOvKFQQsyv\"}",
        "STRIPE_PORTAL_CONFIGURATION_V2": "bpc_1UaPME2OxvOkZCMO8bzVlosn"
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "AIHACKR",
            "class_name": "AIHackrContainer"
          },
          {
            "name": "WEB_DATA_STORE",
            "class_name": "WebDataStore"
          },
          {
            "name": "BROWSER_WORKSPACE",
            "class_name": "BrowserWorkspace"
          },
          {
            "name": "ACCOUNT_DIRECTORY",
            "class_name": "AccountDirectory"
          }
        ]
      },
      "send_email": [
        {
          "name": "EMAIL",
          "allowed_sender_addresses": [
            "hello@aihackr.com"
          ]
        }
      ]
    }
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": [
        "hello@aihackr.com"
      ]
    }
  ]
}
