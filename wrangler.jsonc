{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aihackr",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aihackr-production",
      "database_id": "ccc01fbb-25b6-49a4-860f-4ddf22984515",
      "migrations_dir": "migrations"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["hello@aihackr.com"]
    }
  ],
  "containers": [
    {
      "class_name": "AIHackrContainer",
      "image": "./Dockerfile",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "AIHACKR",
        "class_name": "AIHackrContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AIHackrContainer"]
    }
  ],
  "triggers": {
    "crons": ["*/10 * * * *"]
  }
}
