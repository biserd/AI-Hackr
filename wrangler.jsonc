{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aihackr",
  "main": "native/edge-worker.mjs",
  "compatibility_date": "2026-11-08",
  "workers_dev": true,
  "routes": [
    { "pattern": "aihackr.com", "custom_domain": true },
    { "pattern": "www.aihackr.com", "custom_domain": true }
  ],
  "assets": { "directory": "./dist/public", "binding": "ASSETS", "run_worker_first": true },
  "vars": { "NATIVE_BACKEND_ORIGIN": "" },
  "observability": { "logs": { "enabled": true, "invocation_logs": false } },
  "durable_objects": {
    "bindings": [
      { "name": "AIHACKR", "class_name": "AIHackrContainer" },
      { "name": "WEB_DATA_STORE", "class_name": "WebDataStore" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AIHackrContainer"] },
    { "tag": "v2-web-data-store", "new_sqlite_classes": ["WebDataStore"] }
  ]
}
